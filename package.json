{
  "name": "teiji-tango",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "generate": "node scripts/generate-puzzles.js",
    "validate": "node scripts/validate-puzzles.js"
  },
  "devDependencies": {
